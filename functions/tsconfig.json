{
  "compilerOptions": {
    "module":           "commonjs",
    "target":           "ES2020",
    "lib":              ["ES2020"],
    "strict":           true,
    "esModuleInterop":  true,
    "outDir":           "lib",
    "rootDir":          "src",
    "skipLibCheck":     true
  },
  "compileOnSave": true,
  "include": ["src"]
}
