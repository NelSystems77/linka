rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Encrypted blobs: only authenticated users can read/write
    // Participant-level access is enforced client-side + Firestore rules
    match /encrypted/{conversationId}/{fileId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024   // 50 MB max
                   && request.resource.contentType == 'application/octet-stream';
      allow delete: if false;  // deleted only by Cloud Functions (TTL)
    }
  }
}
