rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isSelf(userId) {
      return uid() == userId;
    }

    function role() {
      return userDoc(uid()).role;
    }

    function isActive() {
      let u = userDoc(uid());
      return u.get('isBlocked', false) == false &&
             (!('expiresAt' in u) || u.expiresAt == null || u.expiresAt > request.time.toMillis());
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && (role() == 'admin' || role() == 'super_admin');
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated active user can read any user profile (to get public key)
      allow read: if isSignedIn() && isActive();

      // Only super_admin can create or delete users
      allow create, delete: if isSuperAdmin();

      // super_admin can update anything; admin can update limited fields;
      // users can only update their own profile fields
      allow update: if isSuperAdmin()
        || (isAdmin() && isActive() && !('role' in request.resource.data.diff(resource.data).affectedKeys()))
        || (isSelf(userId) && isActive() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastSeenAt', 'mustChangePassword', 'publicKey', 'status', 'avatarUrl']));
    }

    // ── Conversations ─────────────────────────────────────────────────
    match /conversations/{convId} {
      // Participant can read their own conversations
      allow read: if isSignedIn() && isActive()
        && uid() in resource.data.participants;

      // Any authenticated active user can create a conversation they're part of
      allow create: if isSignedIn() && isActive()
        && uid() in request.resource.data.participants;

      allow update: if isSignedIn() && isActive()
        && uid() in resource.data.participants
        && (
          // Any participant can update lastMessageAt and/or unreadCounts (send message, mark read)
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageAt', 'unreadCounts', 'lastMessage', 'lastMessageSenderId', 'lastMessageType'])
          || (
            // A participant can remove only themselves from a room (leave)
            resource.data.type == 'room'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
            && request.resource.data.participants.toSet().difference(resource.data.participants.toSet()).size() == 0
            && resource.data.participants.toSet().difference(request.resource.data.participants.toSet()) == [uid()].toSet()
          )
        );

      // Only the room creator can dissolve their own room
      allow delete: if isSignedIn() && isActive()
        && resource.data.type == 'room'
        && resource.data.createdBy == uid();
    }

    // ── Messages ──────────────────────────────────────────────────────
    match /messages/{msgId} {
      function convData() {
        return get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data;
      }

      function newConvData() {
        return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data;
      }

      // Only participants of the conversation can read
      allow read: if isSignedIn() && isActive()
        && uid() in convData().participants;

      // Only the sender can create a message in a conversation they're in
      allow create: if isSignedIn() && isActive()
        && request.resource.data.senderId == uid()
        && uid() in newConvData().participants;

      // Messages are immutable once written (E2EE integrity)
      allow update: if false;

      // Only the room creator can delete messages when dissolving
      allow delete: if isSignedIn() && isActive()
        && convData().type == 'room'
        && convData().createdBy == uid();
    }

    // ── Files ─────────────────────────────────────────────────────────────
    match /files/{fileId} {
      function fileConvParticipants() {
        return get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      }

      allow read: if isSignedIn() && isActive()
        && uid() in fileConvParticipants();

      allow create: if isSignedIn() && isActive()
        && request.resource.data.uploadedBy == uid();

      allow update, delete: if false;
    }

    // ── Chat Requests ─────────────────────────────────────────────────────────
    match /chatRequests/{requestId} {
      allow read: if isSignedIn() && isActive()
        && (resource.data.fromUid == uid() || resource.data.toUid == uid());

      allow create: if isSignedIn() && isActive()
        && request.resource.data.fromUid == uid();

      allow update: if isSignedIn() && isActive()
        && (resource.data.fromUid == uid() || resource.data.toUid == uid())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // ── Audit Log ─────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;  // written only by backend (Firebase Admin SDK)
    }
  }
}
